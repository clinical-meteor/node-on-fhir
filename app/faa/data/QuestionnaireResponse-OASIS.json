        "repeats": false,
        "readOnly": false,
        "maxLength": 10
      },
      {
        "linkId": "Section-20/A0100B",
        "prefix": "A0100B",
        "text": "Does the patient have a CMS Certification Number (CCN)?",
        "type": "text",
        "repeats": false,
        "readOnly": false,
        "maxLength": 12
      },
      {
        "linkId": "Section-20/A0600A",
        "prefix": "A0600A",
