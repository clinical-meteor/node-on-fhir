      },
      {
        "linkId": "Section-20/A0700",
        "prefix": "A0700",
        "text": "The patient's Medicaid number should be entered in the provided space. If the Medicaid application is pending, enter \"+\". If the patient is not a Medicaid recipient, enter \"N\".",
